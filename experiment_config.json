    "eta_min": 1e-05,
    "step": "per epoch"
  },
  "augmentation": "train only: synchronised hflip p=0.5, vflip p=0.5, rot90 k in {1,2,3} p=0.5",
  "data_order": "DataLoader shuffle with torch.Generator seeded 42 and a dedicated random.Random(42) augmentation stream, both re-created for each model -> identical batches/augmentations for both models",
  "models": {
    "baseline": "SegmentationUNet(base_ch=32, use_dilated_bottleneck=False): bottleneck = DoubleConv(256,512)",
